{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "ES2022"
        ],
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "outDir": "dist",
        "rootDir": ".",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": false
    },
    "include": [
        "server.ts",
        "src/**/*.ts"
    ]
}